# PostgreSQL connection (Homebrew default user is your macOS username)
DATABASE_URL="postgresql://localhost:5432/famplan"

# Express server
PORT=3001
NODE_ENV=development
# Public origin used in password-reset links
APP_ORIGIN="http://localhost:5173"

# Seeded accounts (created by `npm run db:seed`)
ADMIN_EMAIL="admin@famplan.sg"
ADMIN_PASSWORD="ChangeMe-Admin-2026"
DEMO_EMAIL="demo@famplan.sg"
DEMO_PASSWORD="ChangeMe-Demo-2026"

# Automatic synchronisation (FR-ADM-03). Daily at 04:00 Singapore time.
SYNC_CRON="0 4 * * *"
# Run a sync at startup when any source has never succeeded or is older than 24 h
SYNC_ON_STARTUP=true
# Comma-separated source ids to force-fail (demonstrates FR-RES-01), e.g. "moe-schools"
SYNC_FAIL_SOURCES=""

# Optional: OneMap account for live routing (FR-TRV-02). Register at https://www.onemap.gov.sg/apidocs/register
ONEMAP_EMAIL=""
ONEMAP_PASSWORD=""

# Optional: SMTP for password-reset email. When unset, reset links are printed to the server console.
SMTP_URL=""
MAIL_FROM="FamPlan <no-reply@famplan.local>"
